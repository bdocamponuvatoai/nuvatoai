{
  "name": "nuvato-ai",
  "version": "1.0.0",
  "description": "Nuvato AI marketing site — websites, AI agents, automation, documentation, and enterprise platforms.",
  "author": "Blair — Lead Website Developer, Nuvato AI",
  "homepage": "https://nuvato.ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:assets": "vitest run --mode remote-assets tests/assets.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.6",
    "lucide-react": "^1.58.0",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@types/mdx": "2.0.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
