# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables (or with `vercel env add`).

# Canonical public origin used for canonical URLs, Open Graph, the sitemap, and JSON-LD.
# Defaults to the Vercel production domain, or http://localhost:3000 locally.
SITE_URL=https://www.nuvato.ai

# Allow search engines to index the site. Only honored on production deployments;
# previews are always noindex. Leave unset (or false) until the public launch.
SITE_INDEXABLE=false

# Upstream service that owns availability and calendar invitations.
BOOKING_SERVICE_ORIGIN=https://nuvato.ai

# Booking rate limiter (required in production; bookings fail closed without it).
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# Local development falls back to an in-memory limiter when these are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: serve images from a different ImageKit folder (defaults to the Nuvato folder).
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/isakglobalventures/nuvato
