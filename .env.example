# Every variable is optional. Copy to .env.local for local development, or set them
# in Vercel under Project Settings → Environment Variables (type: Config, not Secret).

# Canonical public origin used for canonical URLs, Open Graph, the sitemap, and JSON-LD.
# Defaults to the Vercel production domain, or http://localhost:3000 locally.
SITE_URL=https://www.nuvato.ai

# Allow search engines to index the site. Only honored on production deployments;
# previews are always noindex. Leave unset (or false) until the public launch.
SITE_INDEXABLE=false

# Optional: serve images from a different ImageKit folder (defaults to the Nuvato folder).
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/isakglobalventures/nuvato
