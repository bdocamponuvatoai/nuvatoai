# Every variable is optional. Copy to .env.local for local development, or set them
# in Vercel under Project Settings → Environment Variables (type: Config, not Secret).

# Canonical public origin used for canonical URLs, Open Graph, the sitemap, and JSON-LD.
# Defaults to https://nuvato.ai on every Vercel deployment, or http://localhost:3000 locally.
# Leave it unset in Vercel unless the public domain changes. Never a *.vercel.app address.
# SITE_URL=https://nuvato.ai

# Production deployments are open to search engines and AI crawlers; false closes them.
# Previews are always noindex. true makes a local build indexable, to test robots.txt.
# SITE_INDEXABLE=false

# Turn on Google Analytics (and its consent banner) outside production, for testing.
# Production deployments always have analytics on; previews and local development don't.
# ENABLE_ANALYTICS=true

# Optional: serve images from a different ImageKit folder (defaults to the Nuvato folder).
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/isakglobalventures/nuvato
